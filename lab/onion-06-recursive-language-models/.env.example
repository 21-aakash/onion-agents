# Copy this file to .env and fill in your values
# cp .env.example .env

# Required for scripts 02 and 03 (any OpenAI-compatible endpoint)
OPENAI_API_KEY=your_api_key_here

# Base URL for OpenAI-compatible endpoint (default: OpenAI public API)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the model (default: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Script 01 (local Ollama) needs no env vars
# Make sure `ollama serve` is running and qwen3:4b is pulled
